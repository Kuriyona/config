# ── 服务端（相对路径按仓库根解析） ──
SYNC_HOST=127.0.0.1        # 绑定地址；非回环时必须设 SYNC_TOKEN，否则启动即退出
SYNC_PORT=8787
SYNC_DATA=./data           # 权威副本
SYNC_HISTORY=./history     # 覆盖/删除前的归档
SYNC_STATE_DIR=./.sync-server
SYNC_FILTERS=./sync-filters.txt
SYNC_TOKEN=                # 客户端用 Authorization: Bearer <token>

# ── 客户端（相对路径按 SYNC_ROOT 解析） ──
# SYNC_URL=http://127.0.0.1:8787
# SYNC_ROOT=               # 默认 = <仓库根>/payload（payload 独立目录）
# SYNC_DEVICE=             # 默认 = hostname（WSL 追加 "-<发行版>"）
# SYNC_STATE_DIR=./.sync
# SYNC_FILTERS=            # 默认 = <仓库根>/sync-filters.txt
